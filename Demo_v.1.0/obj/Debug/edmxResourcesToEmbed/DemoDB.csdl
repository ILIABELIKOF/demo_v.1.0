    <EntitySet Name="Users" EntityType="Self.User" />
    <AssociationSet Name="FK_Clients_Orders" Association="Self.FK_Clients_Orders">
      <End Role="Orders" EntitySet="Orders" />
      <End Role="Clients" EntitySet="Clients" />
    </AssociationSet>
    <AssociationSet Name="FK_Orders_Order_type" Association="Self.FK_Orders_Order_type">
