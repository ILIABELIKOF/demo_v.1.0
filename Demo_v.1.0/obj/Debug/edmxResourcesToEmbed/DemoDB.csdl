    <Property Name="IsBlocked" Type="Boolean" Nullable="false" />
  </EntityType>
  <Association Name="FK_Clients_Orders">
    <End Role="Orders" Type="Self.Order" Multiplicity="1" />
    <End Role="Clients" Type="Self.Client" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Orders">
        <PropertyRef Name="id" />
      </Principal>
      <Dependent Role="Clients">
        <PropertyRef Name="client_order_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Orders_Order_type">
    <End Role="Order_type" Type="Self.Order_type" Multiplicity="1" />
    <End Role="Orders" Type="Self.Order" Multiplicity="*" />
    <ReferentialConstraint>
