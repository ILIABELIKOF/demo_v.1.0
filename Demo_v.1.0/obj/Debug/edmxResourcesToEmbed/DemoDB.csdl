        <PropertyRef Name="specification_item_type_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="DemoDBEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Clients" EntityType="Self.Client" />
    <EntitySet Name="Order_type" EntityType="Self.Order_type" />
    <EntitySet Name="Orders" EntityType="Self.Order" />
    <EntitySet Name="Specifications" EntityType="Self.Specification" />
    <EntitySet Name="Specification_item_type" EntityType="Self.Specification_item_type" />
