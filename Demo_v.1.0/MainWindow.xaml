<Window x:Class="Demo_v._1._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_v._1._0"
        mc:Ignorable="d"
        Title="Авторизация" Height="500" Width="400" Background="LightBlue">
    <Grid>
        <StackPanel Margin="0, 50">
            <TextBlock Text="Логин" FontSize="40" Margin="0, 50, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="txtLogin" Height="30" Width="100" VerticalAlignment="Center" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
            <TextBlock Text="Пароль" FontSize="40" Margin="0, 10, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Height="30" Width="100"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Content="Войти" Margin="0, 100" Width="70" IsDefault="True" Click="Button_Auth_Click"/>
        </StackPanel>
    </Grid>
</Window>
