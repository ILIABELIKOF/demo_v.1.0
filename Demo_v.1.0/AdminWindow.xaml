<Window x:Class="Demo_v._1._0.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_v._1._0"
        mc:Ignorable="d"
        Title="Панель администратора" Height="450" Width="800" Background="LightCyan">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <DataGrid
            x:Name="DataGridUsers"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="False"
            SelectionMode="Single" 
            Background="Transparent"
            ColumnWidth="*"
            Margin="0,0,0,10"
            Grid.Column="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding lastname}" Width="*"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding password}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="*"/>
                <DataGridTextColumn Header="Статус блокировки" Binding="{Binding IsBlocked}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Column="1" Margin="0, 20, 0, 0">
            <TextBlock Text="Имя" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtName" VerticalContentAlignment="Center" Margin="0, 10, 0, 10" Width="70" Height="15"/>
            <TextBlock Text="Фамилия" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtLastname" VerticalContentAlignment="Center" Margin="0, 10, 0, 10" Width="70" Height="15"/>
            <TextBlock x:Name="txtLogin" FontWeight="Bold" Text="Логин" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox Margin="0, 10, 0, 10" VerticalContentAlignment="Center" Width="70" Height="15"/>
            <TextBlock Text="Пароль" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtPassword" VerticalContentAlignment="Center" Margin="0, 10, 0, 10" Width="70" Height="15"/>
            <TextBlock Text="Роль" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtRole" VerticalContentAlignment="Center" Margin="0, 10, 0, 10" Width="70" Height="15"/>
            <Button Content="Сохранить" Margin="0, 20" Width="70" Height="20" Click="Button_Save_Click" IsDefault="True"/>
            <Button Content="Удалить" Margin="0, 20" Width="70" Height="20" Click="Button_Delete_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
